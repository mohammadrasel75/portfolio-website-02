# Copy this file to .env (or .env.local) and replace the values with your EmailJS keys
# Vite requires env vars to start with VITE_

VITE_EMAILJS_SERVICE_ID=service_xxx
VITE_EMAILJS_TEMPLATE_ID=template_xxx
VITE_EMAILJS_PUBLIC_KEY=your_public_key


VITE_USE_SERVER_EMAIL
VITE_SERVER_URL
VITE_EMAILJS_PUBLIC_KEY

# Optional: default receiver (used inside your EmailJS template if you want)
VITE_EMAILJS_TO_EMAIL=devraselmiah75@gmail.com

# If you want to use the server-side email sender instead of EmailJS, set this to true
# Then configure the SMTP settings below and run `npm run server` to start the server.
VITE_USE_SERVER_EMAIL=false

# Server SMTP settings (used by server/index.js)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_smtp_user@gmail.com
SMTP_PASS=your_smtp_password_or_app_password
EMAIL_TO=devraselmiah75@gmail.com

# Frontend -> server base URL (used in development). Example: http://localhost:4000
VITE_SERVER_URL=http://localhost:4000
